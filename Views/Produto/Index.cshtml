@{
    ViewData["Title"] = "Lista de Produtos";
    
    var nomes = ViewBag.ListaNomes as List<string>;
    var precos = ViewBag.ListaPrecos as List<double>;
}

<h2>Minha Lista de Produtos</h2>

<table class="table" border="1" style="border-collapse: collapse; width: 50%; text-align: left;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th>#</th>
            <th>Nome</th>
            <th>Preço</th>
        </tr>
    </thead>
    <tbody>
    @for (int i = 0; i < nomes.Count; i++)
    {
        @if (precos[i] < 100)
        {
            <tr>
                <td style="background-color: #e4e4e4;">@(i + 1)</td>
                <td style="background-color: #e4e4e4;">@nomes[i]</td>
                <td style="background-color: #0cd33b; color: #292b29; font-weight: bold;">R$ @precos[i]</td>
            </tr>
        }
        else
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@nomes[i]</td>
                <td>R$ @precos[i]</td>
            </tr>
        }
    }
</tbody>
</table>

<br />
<p><strong>Total: @nomes.Count produtos</strong></p>